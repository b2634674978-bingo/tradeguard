# 本地开发可复制为 .streamlit/secrets.toml（不要提交到 Git）。
# Streamlit Community Cloud：把下面的配置粘贴到 App Settings → Secrets。
ADMIN_PASSWORD = "change-this-to-a-long-random-password"

# 持久化数据库（可选）。填了就用 PostgreSQL，重启不丢数据；留空则回落本地 SQLite。
# Supabase / Neon 控制台可直接复制连接串；注意把密码里的特殊字符做 URL 编码。
DATABASE_URL = "postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"
